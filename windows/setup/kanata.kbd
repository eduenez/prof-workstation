;; windows/setup/kanata.kbd — Caps Lock "supercharged" (same behaviour as dotfiles/karabiner on the Macs):
;;   Caps Lock tapped alone (released within 1 s, no other key) -> Esc
;;   Caps Lock held with another key                            -> Left Ctrl
;;   Shift + Caps Lock held                                     -> Shift+Ctrl (follows from the above)
;;   Left Ctrl + Caps Lock                                      -> real Caps Lock toggle
;; Shift+Win+V -> F13, with Shift and Win released (Windows' own Shift+Win+V, "focus a
;;   notification", never sees it). Ditto's "Activate Ditto" hotkey is set to F13 by pressing
;;   Shift+Win+V in its shortcut box while kanata runs. Win+V alone still reaches Windows.
;; Launchers, same pattern: Shift+Win+E -> Ctrl+Alt+F14, Shift+Win+K -> Ctrl+Alt+F15 (Shift and
;;   Win released first). These are the hotkeys of the Start-menu shortcuts "Emacs (WSL)" and
;;   "Restart kanata" (set by packages.cmd). No keyboard has F14/F15, so you never type these
;;   Ctrl+Alt combos and Emacs never receives them: Explorer takes them first.
;;   Win+E and Win+K alone still reach Windows.
;; No layers, so nothing changes (or gets logged) when Left Ctrl is pressed.
;; Comments in kanata start with TWO semicolons.
;; Test:  kanata_windows_gui_winIOv2_x64.exe -c <this file>   (Ctrl-C to stop)

(defcfg
  ;; kanata must see the other keys to tell "Caps tapped" from "Caps held with a key".
  ;; keypad Enter (kanata name: kprt) is left untouched: kanata cannot track it on Windows (beep + balloon).
  process-unmapped-keys (all-except kprt)
  ;; tray build: don't look for a per-layer tray icon (avoids "icon_0_key" warnings)
  icon-match-layer-name no
)

(defsrc caps e k v)

(defalias
  ;; fork: if Left Ctrl is already held, Caps Lock is a plain Caps Lock (with Ctrl released);
  ;; otherwise tap = esc, and it becomes Left Ctrl as soon as another key is pressed or after 1 s
  cap (fork (tap-hold-press 200 1000 esc lctl) (unmod caps) (lctl))
  ;; v: if a Win key is held AND a Shift key is held -> F13 (modifiers released); otherwise plain v
  v   (fork v (fork v (unmod f13) (lsft rsft)) (lmet rmet))
  ;; e, k: same test; Shift+Win -> Ctrl+Alt+F14 / Ctrl+Alt+F15 (launchers, see top)
  e   (fork e (fork e (unmod lctl lalt f14) (lsft rsft)) (lmet rmet))
  k   (fork k (fork k (unmod lctl lalt f15) (lsft rsft)) (lmet rmet))
)

(deflayer base @cap @e @k @v)
