# ~/.zshrc — Oh My Zsh interactive shell configuration.
# Managed by prof-workstation; do not edit directly.
# For local overrides (API keys, machine-specific PATH, etc.), use ~/.zshrc.local.

# ── Emacs TRAMP ───────────────────────────────────────────────────────
# TRAMP (Emacs remote editing over ssh) logs in with TERM=dumb and needs a
# plain, static prompt and no interactive questions. Oh My Zsh breaks both:
# its async git prompt and title-bar escapes never settle, and its update
# prompt ("Would you like to update? [Y/n]") swallows TRAMP's handshake —
# worse, "[Y/n] " false-matches TRAMP's shell-prompt regexp, hanging Emacs
# at 100% CPU. For dumb terminals: bare prompt, load nothing else, done.
# (Canonical fix from the TRAMP manual's FAQ.)
if [[ "$TERM" == "dumb" ]]; then
  unsetopt zle prompt_cr prompt_subst
  PS1='$ '
  return
fi

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="ys"

plugins=(git)

source "$ZSH/oh-my-zsh.sh"

# ── iTerm2 ────────────────────────────────────────────────────────────
export ITERM_ENABLE_SHELL_INTEGRATION_WITH_TMUX=YES

# ── Editor ────────────────────────────────────────────────────────────
if [[ -n $SSH_CONNECTION ]]; then
    export EDITOR='emacs -nw'
else
    export EDITOR='emacs -nw'
    export VISUAL='emacs'
fi

# ── Local bin (uv tools, pip --user installs) ─────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# ── Aliases ───────────────────────────────────────────────────────────
alias ls='gls --color=auto'
alias ll='gls -lh --color=auto'
alias la='gls -lAh --color=auto'
alias tmucs='tmux -CC new -A -s main'

# ── Local overrides ───────────────────────────────────────────────────
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

[ -n "$EAT_SHELL_INTEGRATION_DIR" ] && \
    source "$EAT_SHELL_INTEGRATION_DIR/zsh"

# ── fzf (key bindings + completion) ───────────────────────────────────
# `fzf --zsh` needs fzf ≥ 0.48; works for Homebrew and MacPorts builds alike.
command -v fzf >/dev/null && eval "$(fzf --zsh)"
