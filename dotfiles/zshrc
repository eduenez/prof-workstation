# ~/.zshrc — Oh My Zsh interactive shell configuration.
# Managed by prof-workstation; do not edit directly.
# For local overrides (API keys, machine-specific PATH, etc.), use ~/.zshrc.local.

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="ys"

plugins=(git)

source "$ZSH/oh-my-zsh.sh"

# ── iTerm2 ────────────────────────────────────────────────────────────
export ITERM_ENABLE_SHELL_INTEGRATION_WITH_TMUX=YES

# ── Editor ────────────────────────────────────────────────────────────
if [[ -n $SSH_CONNECTION ]]; then
    export EDITOR='emacs -nw'
else
    export EDITOR='emacs -nw'
    export VISUAL='emacs'
fi

# ── Local bin (uv tools, pip --user installs) ─────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# ── Aliases ───────────────────────────────────────────────────────────
alias ls='gls --color=auto'
alias ll='gls -lh --color=auto'
alias la='gls -lAh --color=auto'
alias tmucs='tmux -CC new -A -s main'

# ── Local overrides ───────────────────────────────────────────────────
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
