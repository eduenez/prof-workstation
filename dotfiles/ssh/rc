#!/bin/sh
# ~/.ssh/rc — managed by prof-workstation (dotfiles/ssh/rc).  sshd runs it at every login, before the shell.
#
# sshd skips its own X11 cookie setup when this file exists, so this file does it.
#
# It used to relink ~/.ssh/agent.sock (tmux's agent) to every login's forwarded agent.  That let any login, even an
# scp or a git fetch, take signing away from the machine you were typing on; tmux's client-attached hook does it now
# (dotfiles/bin/tmux-agent-link).  This file stays for the X11 part.

if read -r proto cookie && [ -n "$DISPLAY" ]; then
    xauth_bin=$(command -v xauth || echo /opt/X11/bin/xauth)
    if [ -x "$xauth_bin" ]; then
        case "$DISPLAY" in
            localhost:*) echo "add unix:${DISPLAY#localhost:} $proto $cookie" ;;
            *)           echo "add $DISPLAY $proto $cookie" ;;
        esac | "$xauth_bin" -q -
    fi
fi
