# ~/.zprofile — Login shell configuration (sourced once per login, before .zshrc).
# Managed by prof-workstation; do not edit directly.
# Every block below is guarded, so this file also works on machines without
# Homebrew (MacPorts: macbook-gai, macbook-utsa). Machine-specific PATH entries
# and the like belong in ~/.zprofile.local, sourced at the very end.

# ── Homebrew ──────────────────────────────────────────────────────────
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"   # Apple Silicon
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"       # Intel
fi

# ── rbenv ─────────────────────────────────────────────────────────────
# A git-installed rbenv lives in ~/.rbenv/bin (not on PATH yet); Homebrew's is.
[[ -d "$HOME/.rbenv/bin" ]] && export PATH="$HOME/.rbenv/bin:$PATH"
if command -v rbenv &>/dev/null; then
    eval "$(rbenv init - --no-rehash zsh)"
fi

# ── Google Cloud SDK ──────────────────────────────────────────────────
_gcloud_prefix="$(brew --prefix 2>/dev/null)/Caskroom/google-cloud-sdk/latest/google-cloud-sdk"
[[ -f "$_gcloud_prefix/path.zsh.inc"       ]] && source "$_gcloud_prefix/path.zsh.inc"
[[ -f "$_gcloud_prefix/completion.zsh.inc" ]] && source "$_gcloud_prefix/completion.zsh.inc"
unset _gcloud_prefix

# ── opam (OCaml) ──────────────────────────────────────────────────────
[[ -r "$HOME/.opam/opam-init/init.zsh" ]] && \
    source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2>&1

# ── SSH agent (Bitwarden) ─────────────────────────────────────────────
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"

# ── Local overrides ───────────────────────────────────────────────────
[[ -f "$HOME/.zprofile.local" ]] && source "$HOME/.zprofile.local"
