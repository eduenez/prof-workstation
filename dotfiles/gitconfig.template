[user]
	name  = {{NAME}}
	email = {{EMAIL}}

[credential]
	helper = osxkeychain

[pull]
	rebase = true

[push]
	autoSetupRemote = true

# Push to GitHub over ssh (the Bitwarden agent) even for clones made with an https URL;
# fetches keep their URL (https: anonymous for public repos, `gh auth setup-git` for private ones).
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[core]
	excludesfile = ~/.gitignore_global
	autocrlf     = input

[filter "lfs"]
	clean    = git-lfs clean -- %f
	smudge   = git-lfs smudge -- %f
	process  = git-lfs filter-process
	required = true

[alias]
	lg  = log --oneline --graph --decorate --all
	st  = status -sb
	com = commit
	co  = checkout
	br  = branch -vv
